CORE_RPC_USERNAME=node
CORE_RPC_PASSWORD=changeme
# flip to "electrum" once electrs has finished its initial sync
MEMPOOL_BACKEND=none
# Where bitcoind and electrs live, as seen from inside the containers
# (a LAN IP of the host when they run natively; host.docker.internal does not
# work on this setup).
CORE_RPC_HOST=192.0.2.10
ELECTRUM_HOST=192.0.2.10
# MariaDB for the backend. Default is the compose "db" service; point at an
# external server (host, port) to run the database outside compose.
MEMPOOL_DB_HOST=db
MEMPOOL_DB_PORT=3306
